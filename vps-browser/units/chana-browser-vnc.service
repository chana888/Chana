[Unit]
Description=回环远程桌面
After=network.target chana-browser-display.service
Requires=chana-browser-display.service
[Service]
Type=simple
User=chana-browser
Group=chana-browser
WorkingDirectory=/opt/chana-vps-browser
Environment=HOME=/var/lib/chana-browser
Environment=DISPLAY=:97
Environment=XAUTHORITY=/var/lib/chana-browser/.Xauthority
ExecStart=/usr/bin/x11vnc -display :97 -auth /var/lib/chana-browser/.Xauthority -no6 -listen 127.0.0.1 -rfbport 5971 -nopw -forever -shared -noxdamage -quiet
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
MemoryMax=150M
TasksMax=256
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
