        function getFieldType(e, index) {
            var searchControls = [];
            for (var i = 0; i < searchControls.length; i++) {
                searchControls[i].destroy(); // 先销毁全部搜索控件
            }
            //searchControls = []; // 清空控件数组
            $("#serachArea_" + index).html(""); // 再清空搜索条件区域
            var field = e.value;
            var fieldTypeEn = fieldTypeObj[field];
            var codeList = codeJson[field];
            var logic = [{id: 'equal', text: '等于'}, {id: 'gte', text: '大于等于'}, {id: 'lte', text: '小于等于'}, {
                id: 'ne',
                text: '不等于'
            }, {id: 'gt', text: '大于'}, {id: 'lt', text: '小于'}, {id: 'like', text: '模糊匹配'}, {
                id: 'in',
                text: '包含'
            }, {id: 'notin', text: '不包含'}, {id: 'empty', text: '为空'}, {id: 'notempty', text: '不为空'}];
            if (fieldTypeEn == 'N') {
                //数字(N) 不支持包含，不包含，而且后台Java对应的类型是int
                logic = [{id: 'equal', text: '等于'}, {id: 'gt', text: '大于'}, {id: 'lt', text: '小于'}, {
                    id: 'gte',
                    text: '大于等于'
                }, {id: 'lte', text: '小于等于'}, {id: 'ne', text: '不等于'}, {id: 'empty', text: '为空'}, {
                    id: 'notempty',
                    text: '不为空'
                }];
            } else if (fieldTypeEn == 'D') {
                //日期(D) 不支持包含，不包含，
                logic = [{id: 'equal', text: '等于'}, {id: 'gt', text: '大于'}, {id: 'lt', text: '小于'}, {
                    id: 'gte',
                    text: '大于等于'
                }, {id: 'lte', text: '小于等于'}, {id: 'ne', text: '不等于'}, {id: 'empty', text: '为空'}, {
                    id: 'notempty',
                    text: '不为空'
                }];
            } else if (fieldTypeEn == 'C') {
                logic = [{id: 'equal', text: '等于'}, {id: 'ne', text: '不等于'}, {id: 'like', text: '模糊匹配'}, {
                    id: 'empty',
                    text: '为空'
                }, {id: 'notempty', text: '不为空'}];
            }
            mini.get("logicRelation_" + index).setValue('');
            mini.get("logicRelation_" + index).setData(logic);
            if (codeList) {
                var comboBox = new mini.ComboBox();
                comboBox.setEmptyText("请输入条件值");
                comboBox.setId("paramValue_" + index);
                comboBox.setName("paramValue");
                comboBox.setValueField("code_key");
                comboBox.setTextField("code_value");
                comboBox.setStyle("width:100%");
                comboBox.setData(codeList);
                comboBox.setAllowInput(true);
                $("#serachArea_" + index).append(comboBox.getEl());
                searchControls.push(comboBox);
            } else {
                if (fieldTypeEn == 'N' || fieldTypeEn == 'C') {
                    var textBox = new mini.TextBox();
                    textBox.setEmptyText("请输入条件值");
                    textBox.setId("paramValue_" + index);
                    textBox.setName("paramValue");
                    textBox.setStyle("width:100%");
                    $("#serachArea_" + index).append(textBox.getEl());
                    searchControls.push(textBox);
                } else if (fieldTypeEn == 'D') {
                    var datePicker = new mini.DatePicker();
                    datePicker.setId("paramValue_" + index);
                    datePicker.setName("paramValue");
                    datePicker.setAllowInput(false);
                    datePicker.setStyle("width:100%");
                    $("#serachArea_" + index).append(datePicker.getEl());
                    searchControls.push(datePicker);
                }
            }
        }


