        /**
         * 定时监听文件下载状态
         * @param messageid 遮罩id
         * @param shadeKey 自定义约定好的sessionKey
         */
        function shadeStateListener(messageid) {
            var isHideShade = false;
            setTimeout(function () {
                $.ajax({
                    url: '/EIP/flowcfg/synergy_template/getShadeState.htm?timestamp=' + new Date().getTime(),  //请求的URL
                    type: 'post',  //请求方式，get或post
                    async: false, //false同步、true异步
                    data: {},//请求所传参数，json格式
                    dataType: 'json',//返回的数据格式
                    success: function (data) { //请求成功的回调函数
                        if (data && data.state == '500') {
                            isHideShade = true;
                        }
                    },
                    error: function () {
                        isHideShade = true;
                    }
                });
                if (isHideShade) {
                    // 隐藏遮罩
                    mini.hideMessageBox(messageid);
                } else {
                    // 重新调用自己，直到遮罩隐藏为止
                    shadeStateListener(messageid);
                }
            }, 1000);
        }

