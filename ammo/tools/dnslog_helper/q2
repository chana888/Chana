        /**
         * 功能：获取查询条件数据
         * @author wumingyue
         * @date 2016-03-06
         */
        function onGetQueryData() {
            var paramList = [];
            var param_isOk = true;
            var count = $("#tableData .serach_list").size();
            //当只有一行没有任何条件时，查询所有数据,否则进行条件相关验证
            if (count == 1) {
                $("#tableData .serach_list :input").each(function (i) {
                    //miniui控件渲染后会生成6个input标签，其中mini-combox会生成两个一个时value，一个是text。mini-textbox会多出一个hidden
                    if (i == $("#tableData .serach_list :input").length - 1) {
                        return;
                    }
                    //条件字段跟逻辑运算符不能为空，条件值可以为空
                    if ($.trim($(this).val()) == "" && i != 4 && i != 5) {
                        param_isOk = false;
                        return;
                    }
                });
                if (!param_isOk) {
                    return paramList;
                }
            }
            $("#tableData .serach_list").each(function (i) {
                var paramObject = {};
                paramObject.fieldName = $(this).find("[name='fieldName']").eq(0).val();
                paramObject.fieldCnName = fieldEnCnJson[paramObject.fieldName];
                paramObject.fieldType = fieldTypeObj[paramObject.fieldName];
                paramObject.logicRelation = $(this).find("[name='logicRelation']").eq(0).val();
                paramObject.paramValue = $(this).find("[name='paramValue']").eq(0).val();
                //如果参数值引用了代码集，还需要将代码对应的真正值存下来。例如性别字段：paramValue=1，paramTextValue=男
                var codeList = codeJson[paramObject.fieldName];
                if (codeList) {
                    for (var i = 0; i < codeList.length; i++) {
                        var codeObj = codeList[i];
                        if (codeObj.code_key == paramObject.paramValue) {
                            paramObject.paramTextValue = codeObj.code_value;
                            break;
                        }
                    }
                } else {
                    paramObject.paramTextValue = paramObject.paramValue;
                }
                if (paramObject.fieldName && (paramObject.logicRelation == "empty" || paramObject.logicRelation == "notempty")) {
                    paramList.add(paramObject);
                } else {
                    if (paramObject.fieldName && paramObject.logicRelation && paramObject.paramValue) {
                        paramList.add(paramObject);
                    }
                }

            });
            return paramList;
        }


