        function initDataList() {
            $.ajax({
                url: "/EIP/maindatabase/querymanage/getMQueryFields.htm",
                dataType: "html",
                data: {
                    queryCode: 'rnxzxmzhar5jrrgefgftbmcqkbbmxeht'
                },
                type: "post",
                success: function (text) {
                    PageField = text;
                    grid = new mini.DataGrid();
                    var result = mini.decode(text);
                    if (JSON.stringify(result) == '{}') {
