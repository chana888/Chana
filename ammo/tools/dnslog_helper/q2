        /**
         * 流程删除数据
         */
        function delData(id) {
            var result = mini.decode(PageField);
            if (result.isshowDelMenu != "1") {
                mini.alert("操作失败");
                return;
            }

            if (!id) {
                mini.alert("该条数据不能删除，数据缺少唯一标识字段！");
                return;
            }

            mini.confirm("删除数据不可恢复，您确定要删除该条数据吗？", "提示",
                function (action, value) {
                    if (action == "ok") {
                        var data = {"id": id, "queryCode": 'rnxzxmzhar5jrrgefgftbmcqkbbmxeht'};
                        onSubmit("/EIP/maindatabase/querymanage/delData.htm", "get", data, true, function (json) {
                            var result = mini.decode(json);
                            if (result.code == 200) {
                                //refreshList();
                                ReLoadGridData();
                            } else {
                                mini.alert("操作失败");
                            }
                        });
                    }
                }
            );
        }

        /**
         * 渲染字段类型和字段样式
         */
        function onActionRendererFieldType(e) {
            var result = '';
            var column = e.column;//当前列属性，可以自定义
            var value = e.value;//当前字段的值
            var record = e.record;

            var field_type = column.field_type;//显示类型
            var field_typeid = column.field_typeid;//字段基本类型处理
            var field_null = column.field_null;//空值处理
            var dfk = column.detailFlowkey || '';//流程详情
            var field_css = mini.decode(column.field_css);//字段样式，状态样式
            var field_date_formatter = column.field_date_formatter || 'yyyy-MM-dd HH:mm:ss';

            if (field_typeid == "D") {
                //日期转换
                if (value != null) {
                    value = mini.formatDate(new Date(value), field_date_formatter);
                } else {
                    value = field_null;
                }
            }
            if (typeof (value) == "string" && value.indexOf("@#@") != -1) {
                value = value.split("@#@")[1];
            }
            // 渲染附件
            if (typeof (value) == "string" && value.indexOf("fileupload/") != -1 && value.indexOf("nonlogin/") == -1) {
                var annexStr = "";
                var dataArray = new Array();
                if (value.indexOf("\\") != -1) {
                    dataArray = mini.decode(value.replace(/[\\]/g, ''));
                } else {
                    dataArray = mini.decode(value);
                }
                var imgReg = /^\.?(gif|png|jpg|jpeg|jpe|bmp|dib|jfif|tif|tiff){1}$/i;
                for (var i = 0; i < dataArray.length; i++) {
                    var annex = dataArray[i];
                    //判断当前附件是不是图片，如果是图片，不显示文件名
                    if (imgReg.test(annex.type)) {
                        annexStr += "<span id=\"" + annex.physicalId + "\">" + "<img style=\"vertical-align:middle; cursor:pointer;max-width:60px;max-height:60px;\" onclick=\"downLoadFile(this, '" + annex.url + "', '" + annex.annexName + "', '" + annex.type
                            + "')\" src=\"" + basePath + annex.imagePath + "\" data-url='" + annex.url + "&cache=true' data-type='" + annex.type + "'  alt='" + annex.annexName + annex.type + "'/>";
                    } else {
                        annexStr += "<span id=\"" + annex.physicalId + "\">" + "<img style=\"vertical-align:middle; cursor:pointer;max-width:60px;max-height:60px;\" onclick=\"downLoadFile(this, '" + annex.url + "', '" + annex.annexName + "', '" + annex.type
                            + "')\" src=\"" + basePath + annex.imagePath + "\" data-url='" + annex.url + "&cache=true' data-type='" + annex.type + "'  alt='" + annex.annexName + annex.type + "'/>"
                            + "<a style=\"border:none; text-decoration:none; margin-left:8px;\" href=\"javascript:void(0)\" onclick=\"downLoadFile(this, '"
                            + annex.url + "', '" + annex.annexName + "', '" + annex.type + "')\">" + "<span style=\"vertical-align:middle;\" >" + annex.annexName + annex.type + "</span>" + "</a>"
                            + "</br></span>";
                    }
                }
