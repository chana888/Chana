        /**
         * 初始化表格列
         */
        function initGridColum(result) {
            var isShowFilterRow = false;
            var fieldArr = mini.decode(result.fieldStyle);
            //默认序号列
            var titleArr = [];
            var field = new Object();
            field.header = '序号';
            field.width = '50px';
            field.type = 'indexcolumn';
            field.align = 'left';
            field.headerAlign = 'center';
            //field.cellStyle = "white-space: nowrap;overflow: hidden;text-overflow: ellipsis";
            titleArr.push(field);

            for (var i = 0; i < fieldArr.length; i++) {
                //控制字段是否显示
                if (fieldArr[i].SHOW_LIST == "1") {
                    var field = new Object();
                    field.header = fieldArr[i].INFO_CNNAME;
                    field.field = fieldArr[i].INFO_NAME;
                    field.field_typeid = fieldArr[i].INFO_TYPEID;
                    if (fieldArr[i].ALLOW_FILTER == '1' && fieldArr[i].INFO_TYPEID != "T") {
                        isShowFilterRow = true;
                        codeJson = result.conditionFields.codeJson;
                        var codeList = codeJson[fieldArr[i].INFO_NAME];
                        if (codeList && codeList.length > 0) {
                            var clearobj = {code_key: "", code_value: "全部"};
                            codeList.unshift(clearobj);
                            field.filter = {
                                id: fieldArr[i].INFO_NAME + "Filter",
                                type: "combobox",
                                width: "100%",
                                data: codeList,
                                valueField: "code_key",
                                textField: "code_value",
                                onvaluechanged: "onFilterChanged",
                                allowInput: true
                            };
                        } else {
                            if (fieldArr[i].INFO_TYPEID == "C") {
                                field.filter = {
                                    id: fieldArr[i].INFO_NAME + "Filter",
                                    type: "textbox",
                                    width: "100%",
                                    emptyText: "输入内容进行过滤",
                                    onvaluechanged: "onFilterChanged"
                                };
                            } else if (fieldArr[i].INFO_TYPEID == "D") {
                                field.filter = {
                                    id: fieldArr[i].INFO_NAME + "Filter",
                                    type: "datepicker",
                                    width: "100%",
                                    filterData: [{value: 'equal', text: '等于'}, {value: 'gt', text: '大于'}, {
                                        value: 'lt',
                                        text: '小于'
                                    }, {value: 'ne', text: '不等于'}],
                                    onvaluechanged: "onFilterChanged"
                                };
                            } else if (fieldArr[i].INFO_TYPEID == "N") {
                                field.filter = {
                                    id: fieldArr[i].INFO_NAME + "Filter",
                                    type: "filteredit",
                                    width: "100%",
                                    filterData: [{value: 'equal', text: '等于'}, {value: 'gt', text: '大于'}, {
                                        value: 'lt',
                                        text: '小于'
                                    }, {value: 'ne', text: '不等于'}],
                                    onvaluechanged: "onFilterChanged",
                                    showClose: true
                                };
                            }
                        }
                    }

                    field.field_date_formatter = fieldArr[i].DATE_FORMATER;
                    field.field_type = fieldArr[i].FIELD_TYPE;
                    field.field_css = (fieldArr[i].FIELD_CSS || "{}");
                    field.field_null = (fieldArr[i].FIELD_NULL || "");
                    field.detailFlowkey = result.detailFlowkey || '';//流程详情

                    try {
                        var field_css = mini.decode(field.field_css);//列样式，列值样式，状态列样式
                        if (field_css) {
                            //字段标题样式
                            var col_style = field_css.FIELDSTYLE;
                            if (col_style) {
                                if (col_style.width) {
                                    field.width = col_style.width;
                                }
                                if (col_style.headerAlign) {
                                    field.headerAlign = col_style.headerAlign;
                                }
                                if (col_style.align) {
                                    field.align = col_style.align;
                                }
                                if (col_style.allowSort) {
                                    field.allowSort = col_style.allowSort;
                                }
                            } else {
                                field.width = 100;
                                field.allowSort = true;
                                field.align = 'center';
                                field.headerAlign = 'center';
                            }
                        }
                    } catch (e) {
                        field.width = 100;
                        field.allowSort = true;
                        field.align = 'center';
                        field.headerAlign = 'center';
                    }

                    /*
						field.width = 100;
						field.allowSort = true;
						field.align = 'center';
						field.headerAlign = 'center';
						*/
                    field.renderer = 'onActionRendererFieldType';
                    titleArr.push(field);
                }

            }

            //流程编辑 和删除功能控制
            if (result.updateFlowKey || result.isshowDelMenu == '1' || result.detailFlowkey || result.isshowHis == '1' || result.pageType == 'detail' || result.pageType == 'list_detail') {
                var field = new Object();
                field.header = '操作';
                field.width = 160;
                field.align = 'center';
                field.headerAlign = 'center';
                field.renderer = 'onActionButtonRenderer';
                field.updateFlowKey = result.updateFlowKey || '';//流程编辑
                field.isshowDelMenu = result.isshowDelMenu;//流程删除
                field.detailFlowkey = result.detailFlowkey || '';//流程详情
                field.isshowHis = result.isshowHis;        //查看原始记录
                field.pageType = result.pageType;        //查看记录详情
                titleArr.push(field);
            }

            //grid 信息
            var ordd = new Object();
            ordd.pageSize = 30;
            ordd.sizeList = [30, 50, 100]//'[5,10,20,50,100]';
            ordd.showEmptyText = true;
            ordd.emptyText = '<span class=fontQuery>没有查询到记录！</span>';
            ordd.style = 'width: 100%;height: 100%;';
            ordd.columns = titleArr;
            if (isShowFilterRow) {
                ordd.showFilterRow = true;
            }
            grid.render(document.getElementById('gridDiv'));
            grid.set(ordd);
            if (authRule) {
                grid.setUrl("/EIP/maindatabase/querymanage/queryDataForAuthReceiver.htm?queryCode=rnxzxmzhar5jrrgefgftbmcqkbbmxeht&authid=" + authRule.id);
            } else {
                grid.setUrl("/EIP/maindatabase/querymanage/commonQuery.htm?queryCode=rnxzxmzhar5jrrgefgftbmcqkbbmxeht&uuid=");
            }
        }

        //快捷过滤条件
        function onFilterChanged() {
            var paramList = [];
            var result = mini.decode(PageField);
            var fieldArr = mini.decode(result.fieldStyle);
            for (var i = 0; i < fieldArr.length; i++) {
                //控制字段是否显示
                if (fieldArr[i].SHOW_LIST == "1") {
                    var fieldName = fieldArr[i].INFO_NAME;
                    var fieldCnName = fieldArr[i].INFO_CNNAME;
                    var fieldType = fieldArr[i].INFO_TYPEID;
                    if (fieldArr[i].ALLOW_FILTER == '1') {
                        var logicRelation = "like";
                        if (fieldType == "N") {
                            logicRelation = mini.get(fieldName + "Filter").getFilterValue();
                        } else if (fieldType == "D") {
                            logicRelation = "equal";
                        } else {
                            var codeList = codeJson[fieldName];
                            if (codeList && codeList.length > 0) {
                                logicRelation = "equal";
                            }
                        }
                        var paramValue = mini.get(fieldName + "Filter").getValue();
                        if (paramValue) {
                            var paramObject = {};
                            paramObject.fieldName = fieldName;
                            paramObject.fieldCnName = fieldCnName;
                            paramObject.fieldType = fieldType;
                            paramObject.logicRelation = logicRelation;
                            paramObject.paramValue = paramValue;
                            if (paramObject.fieldName && paramObject.logicRelation && paramObject.paramValue) {
                                paramList.add(paramObject);
                            }
                        }
                    }
                }
            }

            globleCondLogic = "$and";
            var userCondition = {};
            if (paramList && paramList.length > 0) {
                var parmaListStr = mini.encode(paramList);
                userCondition = {userParamList: parmaListStr, joinRelation: globleCondLogic}
            }
            grid.load({usercond: mini.encode(userCondition)});

        }

